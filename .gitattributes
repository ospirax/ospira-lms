# Force LF for files that are executed or parsed on the Linux server.
# Checked out on Windows they would otherwise get CRLF, and a CRLF shebang
# makes the shell fail with "bad interpreter: No such file or directory".
*.sh            text eol=lf
Caddyfile       text eol=lf
*.yml           text eol=lf
*.conf          text eol=lf
.env.example    text eol=lf
