{{!

    @template block_myoverview/progress-bar

    Theme override of block_myoverview/progress-bar
    (theme/ospira/templates/<component>/<name>.mustache shadows the
    component's own template - see
    lib/classes/output/mustache_template_finder.php). Same progress-percent
    input as core's plain-text version; this renders a filled bar instead,
    matching .ospira-dashboard-progress-bar. Purely visual - doesn't touch
    the block's own search/sort/filter/favourite JS.

    Example context (json):
    {
        "progress": 50
    }
}}
<div class="ospira-mycourses-progress">
    <div class="ospira-mycourses-progress__bar"><span style="width: {{progress}}%;"></span></div>
    <span class="ospira-mycourses-progress__value">
        <span class="visually-hidden">{{#str}}aria:courseprogress, block_myoverview{{/str}}</span>
        {{#str}}completepercent, block_myoverview, <span>{{progress}}</span>{{/str}}
    </span>
</div>
