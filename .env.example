# Copy to .env and fill in real values. The real .env is gitignored and
# must never be committed.
#
#   cp .env.example .env && nano .env
#
# Generate strong values for the password fields, e.g.:
#
#   openssl rand -base64 24
#
# Compose aborts with a named error if any non-optional variable below is
# missing, so a half-filled file fails loudly instead of starting a broken
# stack.

# --- Database ------------------------------------------------------------
# Root password is only used by the DB container itself; Moodle connects as
# MARIADB_USER. Do not reuse the same value for both.
MARIADB_ROOT_PASSWORD=
MARIADB_USER=bn_moodle
MARIADB_PASSWORD=
MARIADB_DATABASE=bitnami_moodle

# --- Moodle -> database --------------------------------------------------
# Host is the Compose service name, not localhost. The remaining three must
# match the MARIADB_* values above exactly.
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_USER=bn_moodle
MOODLE_DATABASE_PASSWORD=
MOODLE_DATABASE_NAME=bitnami_moodle

# --- Moodle admin account ------------------------------------------------
# Created on first boot only. Changing these later has no effect - change
# the password inside Moodle instead.
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_EMAIL=
MOODLE_SITE_NAME=Ospira LMS

# --- Public hostname -----------------------------------------------------
# No scheme, no trailing slash. Baked into $CFG->wwwroot during the first
# install and written into absolute URLs throughout the database, so
# changing it afterwards requires a search/replace across the DB. Must match
# the hostname in the Caddyfile.
MOODLE_HOST=learning.ospirax.com

# --- Host binding --------------------------------------------------------
# Where Moodle's container port is published on the host. The reverse proxy
# in front of it (existing nginx/Apache, or the optional Caddy profile)
# forwards here.
#
# Keep the address on 127.0.0.1. Setting it to 0.0.0.0 would expose Moodle
# to the internet over plain HTTP, bypassing TLS entirely.
#
# Port 8081, not 8080: the previous Moodle LMS already serves on 8080 and
# must keep running. Confirm 8081 is also free before starting:
#   sudo ss -tlnp | grep 8081
MOODLE_BIND_ADDR=127.0.0.1
MOODLE_BIND_PORT=8081

# --- Cron ----------------------------------------------------------------
# Minutes between Moodle cron runs. Moodle expects 1. Raising it delays
# email delivery and completion-tracking updates, which the Ospira
# dashboard's progress and pending-task tiles depend on.
MOODLE_CRON_MINUTES=1

# --- Outbound email (optional but strongly recommended) ------------------
# Left blank, Moodle uses PHP mail(), which from a fresh VPS IP is normally
# filtered as spam - parents would never receive password resets or signup
# confirmations. Use a transactional provider (Brevo, Mailgun, SES, ...).
MOODLE_SMTP_HOST=
MOODLE_SMTP_PORT_NUMBER=587
MOODLE_SMTP_USER=
MOODLE_SMTP_PASSWORD=
MOODLE_SMTP_PROTOCOL=tls
